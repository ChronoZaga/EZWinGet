<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- .NET Framework 4.8 ships with Windows 10/11, so Build produces a single EXE (no DLL or runtimeconfig.json) -->
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>EZ.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- Embed debug symbols in the EXE instead of writing a separate PDB -->
		<DebugType>embedded</DebugType>
		<!-- Skip the EZWinGet.exe.config file; the EXE already targets the .NET 4.x runtime -->
		<GenerateSupportedRuntime>false</GenerateSupportedRuntime>
		<FileVersion>1.7.1</FileVersion>
		<Copyright>ChronoZaga</Copyright>
		<AssemblyVersion>1.7.1</AssemblyVersion>
		<Version>1.7.1</Version>
	</PropertyGroup>
	<ItemGroup>
		<EmbeddedResource Include="EZ.ico" />
	</ItemGroup>
</Project>
